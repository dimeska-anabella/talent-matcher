LITELLM_API_KEY=
LITELLM_BASE_URL=

# Use any LiteLLM-supported provider/model naming.
EMBEDDING_MODEL=openai/text-embedding-3-small
CHAT_MODEL=openai/gpt-4o-mini

# Data and storage
CVS_DIR=./cvs
JOBS_DIR=./jobs
CHROMA_DIR=./.chroma
CHROMA_COLLECTION=candidates

# Matching behavior
TOP_K=12
TOP_N=3
USE_LLM_EXPLANATIONS=false
