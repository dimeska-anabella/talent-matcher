LITELLM_API_KEY=
# Set this if using a LiteLLM proxy (e.g. https://your-proxy.azurewebsites.net)
LITELLM_BASE_URL=

# Model names must match what your proxy exposes — run GET /models to check.
# Examples for the hackathon proxy:
EMBEDDING_MODEL=azure/text-embedding-3-large
CHAT_MODEL=anthropic/claude-4-6-sonnet-aws

# Data and storage
CVS_DIR=./data/cvs
JOBS_DIR=./data/jobs
CHROMA_DIR=./.chroma
CHROMA_COLLECTION=candidates

# Matching behavior
TOP_K=12
TOP_N=3
USE_LLM_EXPLANATIONS=false
